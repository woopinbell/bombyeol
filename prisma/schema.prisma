generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 계정 — Auth.js는 JWT 세션(DB 어댑터 없음). 로그인 시 Account로 User를 찾거나 만든다.
// 카카오 이메일은 수집하지 않는다(PRIVACY §2 최소 수집).
// ---------------------------------------------------------------------------

model User {
  id        String    @id @default(cuid())
  name      String?
  locale    String    @default("ko")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts       Account[]
  memberships    Member[]
  spacesCreated  Space[]      @relation("SpaceCreatedBy")
  invitesCreated Invite[]     @relation("InviteCreatedBy")
  invitesUsed    Invite[]     @relation("InviteUsedBy")
  childrenAdded  Child[]
  mediaUploaded  MediaAsset[]
  petsAdded      Pet[]
  moments        Moment[]
  milestones     Milestone[]
  reactions      Reaction[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "kakao" | "google"
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// 가족 Space · 멤버 · 초대
// ---------------------------------------------------------------------------

enum MemberRole {
  parent
  grandparent
  relative
}

model Space {
  id          String    @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy  User           @relation("SpaceCreatedBy", fields: [createdById], references: [id])
  members    Member[]
  invites    Invite[]
  children   Child[]
  pets       Pet[]
  moments    Moment[]
  milestones Milestone[]
  reactions  Reaction[]
  media      MediaAsset[]
  usage      UsageCounter[]

  @@index([createdById])
}

model Member {
  id            String     @id @default(cuid())
  spaceId       String
  userId        String
  role          MemberRole
  relationLabel String? // 할머니·외할아버지 등 자유 입력
  joinedAt      DateTime   @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
}

model Invite {
  id            String     @id @default(cuid())
  spaceId       String
  code          String     @unique // 6자, 혼동 문자 제외. 링크도 같은 코드를 쓴다
  role          MemberRole
  relationLabel String?
  expiresAt     DateTime
  usedAt        DateTime?
  usedById      String?
  revokedAt     DateTime?
  createdById   String
  createdAt     DateTime   @default(now())

  space     Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
}

// 초대 코드 입력 실패 기록(brute-force 방지, G-07·G-11). 보관: 판정 창보다 긴 기간만 필요 → 정리 Cron 대상(G-17).
model InviteCodeAttempt {
  id        String   @id @default(cuid())
  userId    String
  ip        String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// 아이 — Space 생성 직후 등록(태명/이름, 출생 예정일 또는 생일)
// ---------------------------------------------------------------------------

enum ChildStatus {
  expecting
  born
}

model Child {
  id          String      @id @default(cuid())
  spaceId     String
  name        String?
  nickname    String? // 태명·애칭
  dueDate     DateTime?   @db.Date
  birthDate   DateTime?   @db.Date
  status      ChildStatus
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  space      Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdById], references: [id])
  moments    Moment[]
  milestones Milestone[]

  @@index([spaceId])
}

// ---------------------------------------------------------------------------
// 반려동물 — 계정 없는 가족 구성원(PRD §4.2.1). 기념 상태 전환은 Phase 4(memorial).
// ---------------------------------------------------------------------------

enum PetSpecies {
  dog
  cat
  other
}

enum PetStatus {
  living
  memorial
}

model Pet {
  id                 String     @id @default(cuid())
  spaceId            String
  name               String
  species            PetSpecies
  speciesLabel       String? // other일 때 자유 입력(토끼·햄스터 등)
  breed              String?
  birthDate          DateTime?  @db.Date
  birthDateEstimated Boolean    @default(false)
  adoptedAt          DateTime?  @db.Date
  passedAt           DateTime?  @db.Date
  status             PetStatus  @default(living)
  coverAssetId       String?    @unique
  createdById        String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  space      Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdById], references: [id])
  cover      MediaAsset? @relation("PetCover", fields: [coverAssetId], references: [id])
  moments    Moment[]
  milestones Milestone[]

  @@index([spaceId])
}

// ---------------------------------------------------------------------------
// 오늘(봄) — Moment는 사진·영상 기록(media) 또는 부모 일기(diary).
// 대상: childId·petId 중 최대 하나(둘 다 비면 가족 전체) — 마이그레이션의 체크 제약으로 강제.
// ---------------------------------------------------------------------------

enum MomentKind {
  media
  diary
}

model Moment {
  id          String     @id @default(cuid())
  spaceId     String
  childId     String?
  petId       String?
  kind        MomentKind
  body        String?
  takenAt     DateTime // 촬영·기록 시각(피드 정렬 기준)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  child     Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)
  pet       Pet?          @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
  media     MomentMedia[]
  reactions Reaction[]

  @@index([spaceId, takenAt(sort: Desc), id(sort: Desc)])
  @@index([childId, takenAt(sort: Desc)])
  @@index([petId, takenAt(sort: Desc)])
}

// Moment 첨부. 자산 하나는 한 곳에만 붙는다(unique) — 삭제 연쇄(G-05)와 사용량 계산을 단순하게.
model MomentMedia {
  momentId         String
  position         Int
  assetId          String  @unique
  thumbnailAssetId String? @unique // 클라이언트가 만든 썸네일(이미지 자산)

  moment    Moment      @relation(fields: [momentId], references: [id], onDelete: Cascade)
  asset     MediaAsset  @relation("MomentAsset", fields: [assetId], references: [id])
  thumbnail MediaAsset? @relation("MomentThumbnail", fields: [thumbnailAssetId], references: [id])

  @@id([momentId, position])
}

// 마일스톤 — 키·몸무게·첫 걸음 등. 값은 kind별 스키마(zod)로 검증한 JSON.
// 대상: childId·petId 중 정확히 하나 — 체크 제약.
model Milestone {
  id          String   @id @default(cuid())
  spaceId     String
  childId     String?
  petId       String?
  kind        String // 프리셋 키(src/lib/milestones.ts) 또는 custom
  value       Json
  recordedAt  DateTime @db.Date
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space     Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  child     Child?     @relation(fields: [childId], references: [id], onDelete: Cascade)
  pet       Pet?       @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])
  reactions Reaction[]

  @@index([childId, recordedAt(sort: Desc)])
  @@index([petId, recordedAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// 반응 — 좋아요·댓글(가족 멤버만). 대상은 정확히 하나(체크 제약), 이야기(StoryEntry)는 Phase 4에서 추가.
// 다형 targetId 대신 대상별 FK를 둬서 대상 삭제 시 반응이 함께 지워진다.
// ---------------------------------------------------------------------------

enum ReactionKind {
  like
  comment
}

model Reaction {
  id          String       @id @default(cuid())
  spaceId     String
  momentId    String?
  milestoneId String?
  kind        ReactionKind
  body        String? // comment만(체크 제약)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  space     Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  moment    Moment?    @relation(fields: [momentId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])

  @@index([momentId, kind, createdAt])
  @@index([milestoneId, kind, createdAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// 레이트 리밋 — DB 고정 창 카운터(S-6: 비용 게이트의 정확한 판정용). 정리 Cron 대상(G-17).
// ---------------------------------------------------------------------------

model RateCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// 미디어 — 업로드는 pending → confirmed. 참조 mutation은 자기 Space의 confirmed 자산만 받는다(G-02).
// 키: pending/{spaceId}/{id} → 확인 후 spaces/{spaceId}/{id} (ARCHITECTURE §5)
// ---------------------------------------------------------------------------

enum MediaKind {
  image
  video
}

enum MediaStatus {
  pending
  confirmed
  deleted
}

model MediaAsset {
  id           String      @id @default(cuid())
  spaceId      String
  uploadedById String
  kind         MediaKind
  contentType  String
  bytes        Int // 선언 크기 = 서명에 들어간 Content-Length(G-01). 상한 200MB < Int 범위
  status       MediaStatus @default(pending)
  createdAt    DateTime    @default(now())
  confirmedAt  DateTime?
  deletedAt    DateTime?

  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  petCover    Pet?         @relation("PetCover")
  momentMedia MomentMedia? @relation("MomentAsset")
  momentThumb MomentMedia? @relation("MomentThumbnail")

  @@index([spaceId, status])
  @@index([status, createdAt])
}

// Space별 일 단위 사용량(G-15 가시성). 판정은 MediaAsset 합계·RateCounter로 하고, 이 표는 집계·이상치 감시용.
model UsageCounter {
  spaceId          String
  periodKey        String // YYYY-MM-DD (UTC)
  uploadUrlsIssued Int    @default(0)
  bytesConfirmed   BigInt @default(0)
  bytesDeleted     BigInt @default(0)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, periodKey])
}
