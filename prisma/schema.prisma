generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 계정 — Auth.js는 JWT 세션(DB 어댑터 없음). 로그인 시 Account로 User를 찾거나 만든다.
// 카카오 이메일은 수집하지 않는다(PRIVACY §2 최소 수집).
// ---------------------------------------------------------------------------

model User {
  id        String    @id @default(cuid())
  name      String?
  locale    String    @default("ko")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts       Account[]
  memberships    Member[]
  spacesCreated  Space[]           @relation("SpaceCreatedBy")
  invitesCreated Invite[]          @relation("InviteCreatedBy")
  invitesUsed    Invite[]          @relation("InviteUsedBy")
  childrenAdded  Child[]
  mediaUploaded  MediaAsset[]
  petsAdded      Pet[]
  moments        Moment[]
  milestones     Milestone[]
  reactions      Reaction[]
  stories        StoryEntry[]
  storyAsks      StoryAsk[]
  memorials      MemorialProfile[]
  consents       Consent[]
  pregnancy      PregnancyRecord[]
  familyEvents   FamilyEvent[]
  pushTokens     PushToken[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "kakao" | "google"
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// 가족 Space · 멤버 · 초대
// ---------------------------------------------------------------------------

enum MemberRole {
  parent
  grandparent
  relative
}

model Space {
  id          String    @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy  User              @relation("SpaceCreatedBy", fields: [createdById], references: [id])
  members    Member[]
  invites    Invite[]
  children   Child[]
  pets       Pet[]
  moments    Moment[]
  milestones Milestone[]
  reactions  Reaction[]
  stories    StoryEntry[]
  storyAsks  StoryAsk[]
  memorials  MemorialProfile[]
  pregnancy  PregnancyRecord[]
  events     FamilyEvent[]
  consents   Consent[]
  media      MediaAsset[]
  usage      UsageCounter[]

  @@index([createdById])
}

model Member {
  id            String     @id @default(cuid())
  spaceId       String
  userId        String
  role          MemberRole
  relationLabel String? // 할머니·외할아버지 등 자유 입력
  joinedAt      DateTime   @default(now())

  space          Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storiesTold    StoryEntry[]     @relation("StoryNarrator")
  storiesScribed StoryEntry[]     @relation("StoryScribe")
  asksReceived   StoryAsk[]
  memorial       MemorialProfile?

  @@unique([spaceId, userId])
  @@index([userId])
}

model Invite {
  id            String     @id @default(cuid())
  spaceId       String
  code          String     @unique // 6자, 혼동 문자 제외. 링크도 같은 코드를 쓴다
  role          MemberRole
  relationLabel String?
  expiresAt     DateTime
  usedAt        DateTime?
  usedById      String?
  revokedAt     DateTime?
  createdById   String
  createdAt     DateTime   @default(now())

  space     Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
}

// 초대 코드 입력 실패 기록(brute-force 방지, G-07·G-11). 보관: 판정 창보다 긴 기간만 필요 → 정리 Cron 대상(G-17).
model InviteCodeAttempt {
  id        String   @id @default(cuid())
  userId    String
  ip        String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// 아이 — Space 생성 직후 등록(태명/이름, 출생 예정일 또는 생일)
// ---------------------------------------------------------------------------

enum ChildStatus {
  expecting
  born
}

model Child {
  id          String      @id @default(cuid())
  spaceId     String
  name        String?
  nickname    String? // 태명·애칭
  dueDate     DateTime?   @db.Date
  birthDate   DateTime?   @db.Date
  status      ChildStatus
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  space      Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy  User              @relation(fields: [createdById], references: [id])
  moments    Moment[]
  milestones Milestone[]
  pregnancy  PregnancyRecord[]

  @@index([spaceId])
}

// ---------------------------------------------------------------------------
// 반려동물 — 계정 없는 가족 구성원(PRD §4.2.1). 기념 상태 전환은 Phase 4(memorial).
// ---------------------------------------------------------------------------

enum PetSpecies {
  dog
  cat
  other
}

enum PetStatus {
  living
  memorial
}

model Pet {
  id                 String     @id @default(cuid())
  spaceId            String
  name               String
  species            PetSpecies
  speciesLabel       String? // other일 때 자유 입력(토끼·햄스터 등)
  breed              String?
  birthDate          DateTime?  @db.Date
  birthDateEstimated Boolean    @default(false)
  adoptedAt          DateTime?  @db.Date
  passedAt           DateTime?  @db.Date
  status             PetStatus  @default(living)
  coverAssetId       String?    @unique
  createdById        String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  space      Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy  User             @relation(fields: [createdById], references: [id])
  cover      MediaAsset?      @relation("PetCover", fields: [coverAssetId], references: [id])
  moments    Moment[]
  milestones Milestone[]
  stories    StoryEntry[]
  memorial   MemorialProfile?

  @@index([spaceId])
}

// ---------------------------------------------------------------------------
// 오늘(봄) — Moment는 사진·영상 기록(media) 또는 부모 일기(diary).
// 대상: childId·petId 중 최대 하나(둘 다 비면 가족 전체) — 마이그레이션의 체크 제약으로 강제.
// ---------------------------------------------------------------------------

enum MomentKind {
  media
  diary
}

model Moment {
  id          String     @id @default(cuid())
  spaceId     String
  childId     String?
  petId       String?
  kind        MomentKind
  body        String?
  takenAt     DateTime // 촬영·기록 시각(피드 정렬 기준)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  child     Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)
  pet       Pet?          @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
  media     MomentMedia[]
  reactions Reaction[]

  @@index([spaceId, takenAt(sort: Desc), id(sort: Desc)])
  @@index([childId, takenAt(sort: Desc)])
  @@index([petId, takenAt(sort: Desc)])
}

// Moment 첨부. 자산 하나는 한 곳에만 붙는다(unique) — 삭제 연쇄(G-05)와 사용량 계산을 단순하게.
model MomentMedia {
  momentId         String
  position         Int
  assetId          String  @unique
  thumbnailAssetId String? @unique // 클라이언트가 만든 썸네일(이미지 자산)

  moment    Moment      @relation(fields: [momentId], references: [id], onDelete: Cascade)
  asset     MediaAsset  @relation("MomentAsset", fields: [assetId], references: [id])
  thumbnail MediaAsset? @relation("MomentThumbnail", fields: [thumbnailAssetId], references: [id])

  @@id([momentId, position])
}

// 마일스톤 — 키·몸무게·첫 걸음 등. 값은 kind별 스키마(zod)로 검증한 JSON.
// 대상: childId·petId 중 정확히 하나 — 체크 제약.
model Milestone {
  id          String   @id @default(cuid())
  spaceId     String
  childId     String?
  petId       String?
  kind        String // 프리셋 키(src/lib/milestones.ts) 또는 custom
  value       Json
  recordedAt  DateTime @db.Date
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space     Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  child     Child?     @relation(fields: [childId], references: [id], onDelete: Cascade)
  pet       Pet?       @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])
  reactions Reaction[]

  @@index([childId, recordedAt(sort: Desc)])
  @@index([petId, recordedAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// 반응 — 좋아요·별 하나·댓글(가족 멤버만). 대상(Moment·Milestone·StoryEntry)은 정확히 하나(체크 제약).
// 다형 targetId 대신 대상별 FK를 둬서 대상 삭제 시 반응이 함께 지워진다.
// 별 하나(star)는 이야기에 남기는 세대 교차 1비트 신호(PRD §2), 좋아요(like)는 오늘 기록용.
// ---------------------------------------------------------------------------

enum ReactionKind {
  like
  comment
  star
}

model Reaction {
  id           String       @id @default(cuid())
  spaceId      String
  momentId     String?
  milestoneId  String?
  storyEntryId String?
  kind         ReactionKind
  body         String? // comment만(체크 제약)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  moment    Moment?     @relation(fields: [momentId], references: [id], onDelete: Cascade)
  milestone Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  story     StoryEntry? @relation(fields: [storyEntryId], references: [id], onDelete: Cascade)
  createdBy User        @relation(fields: [createdById], references: [id])

  @@index([momentId, kind, createdAt])
  @@index([milestoneId, kind, createdAt])
  @@index([storyEntryId, kind, createdAt])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// 이야기(별) — 어르신의 기억(PRD §4.3). 질문 카드는 코드 카탈로그(src/lib/story-prompts.ts)이고
// 문구는 messages의 키로 찾는다 — DB에는 promptKey만 남긴다(시드·번역 동기화 불필요).
// 화자(narrator)·대필자(scribe)는 Member를 가리키되 이름 스냅샷을 함께 저장한다
// (계정·멤버가 사라져도 이야기는 남는다, PRIVACY §5).
// ---------------------------------------------------------------------------

model StoryEntry {
  id               String   @id @default(cuid())
  spaceId          String
  narratorMemberId String? // 이야기의 주인(어르신). 멤버가 사라지면 null, 스냅샷은 남는다
  narratorName     String? // 스냅샷: 작성 시점 User.name
  narratorLabel    String? // 스냅샷: 작성 시점 Member.relationLabel(할머니 등)
  scribeMemberId   String? // 대필한 가족(화자와 다를 때만)
  scribeName       String? // 스냅샷
  promptKey        String? // 질문 카드 키(자유 이야기는 null)
  category         String? // 카탈로그 카테고리 키(이야기 모음 분류)
  title            String?
  body             String
  storyYear        Int? // 이야기 속 시기(연 단위, 옛 기억은 날짜가 흐릿하다)
  petId            String? // 반려동물에 붙인 이야기(PRD §4.2.1)
  photoAssetId     String?  @unique // 사진에 얽힌 이야기(한 장, 이미지 자산)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  narrator  Member?     @relation("StoryNarrator", fields: [narratorMemberId], references: [id], onDelete: SetNull)
  scribe    Member?     @relation("StoryScribe", fields: [scribeMemberId], references: [id], onDelete: SetNull)
  pet       Pet?        @relation(fields: [petId], references: [id], onDelete: SetNull)
  photo     MediaAsset? @relation("StoryPhoto", fields: [photoAssetId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])
  reactions Reaction[]
  ask       StoryAsk?

  @@index([spaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([narratorMemberId, createdAt(sort: Desc)])
  @@index([petId])
}

// 물어보기 — 가족이 어르신께 질문 카드(또는 직접 쓴 질문)를 보낸다. 답한 이야기가 생기면 entryId로 닫힌다.
// promptKey·question 중 정확히 하나(체크 제약).
model StoryAsk {
  id         String   @id @default(cuid())
  spaceId    String
  askedById  String
  toMemberId String
  promptKey  String?
  question   String?
  entryId    String?  @unique
  createdAt  DateTime @default(now())

  space    Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  askedBy  User        @relation(fields: [askedById], references: [id])
  toMember Member      @relation(fields: [toMemberId], references: [id], onDelete: Cascade)
  entry    StoryEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([toMemberId, entryId])
  @@index([spaceId, createdAt])
}

// 기념 상태(별이 되신 가족·반려동물, PRD §4.5). 행이 있으면 기념 상태 — 지우면 되돌린다.
// 만들 때는 memberId·petId 중 정확히 하나. 멤버가 사라지면 memberId만 null이 되고 이름·관계 스냅샷이 남는다
// (그래서 체크 제약은 "최대 하나").
model MemorialProfile {
  id            String    @id @default(cuid())
  spaceId       String
  memberId      String?   @unique
  petId         String?   @unique
  name          String?
  relationLabel String?
  passedAt      DateTime? @db.Date
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  space     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  member    Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  pet       Pet?    @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([spaceId])
}

// ---------------------------------------------------------------------------
// 동의 기록(PRIVACY §2.4) — 누가·무엇에·언제·어느 버전에 동의했나. 추가 전용(철회는 withdrawnAt).
// terms·privacy는 사용자 단위(spaceId 없음), child_data·pregnancy는 Space 단위. 현재 버전은 src/lib/consents.ts.
// ---------------------------------------------------------------------------

enum ConsentKind {
  terms
  privacy
  child_data
  pregnancy
}

model Consent {
  id          String      @id @default(cuid())
  userId      String
  spaceId     String?
  kind        ConsentKind
  version     String
  grantedAt   DateTime    @default(now())
  withdrawnAt DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([userId, kind, spaceId])
}

// ---------------------------------------------------------------------------
// 임신 기록(태명 시절, PRD §4.2) — 건강 정보. visibility는 서버가 강제한다(PRIVACY §3):
// parents_only(기본)는 parent에게만, family는 모든 멤버에게. 주차는 저장하지 않고 조회 시점에
// 아이의 출생 예정일로 계산한다(예정일이 바뀌어도 맞도록).
// ---------------------------------------------------------------------------

enum PregnancyRecordKind {
  ultrasound
  checkup
  kick
  note
}

enum PregnancyVisibility {
  parents_only
  family
}

model PregnancyRecord {
  id           String              @id @default(cuid())
  spaceId      String
  childId      String
  kind         PregnancyRecordKind
  date         DateTime            @db.Date // 기록·검진 날짜(검진은 예정일 수 있다)
  note         String?
  photoAssetId String?             @unique // 초음파 사진(한 장, 이미지 자산)
  visibility   PregnancyVisibility @default(parents_only)
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  child     Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  photo     MediaAsset? @relation("PregnancyPhoto", fields: [photoAssetId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])

  @@index([childId, date(sort: Desc), id(sort: Desc)])
  @@index([spaceId, createdById])
}

// ---------------------------------------------------------------------------
// 가족 캘린더(PRD §4.4) — 시각 있는 일정은 UTC 순간으로 저장하고 클라이언트가 현지 시각으로 보여준다.
// 종일 일정은 그 날의 UTC 자정(날짜만 의미)으로 저장하고 시간대 변환 없이 날짜로 보여준다.
// 매년 반복은 조회 시점에 펼친다(정시 push 없음).
// ---------------------------------------------------------------------------

enum FamilyEventKind {
  gathering
  birthday
  anniversary
  other
}

enum FamilyEventRecurrence {
  none
  yearly
}

model FamilyEvent {
  id          String                @id @default(cuid())
  spaceId     String
  title       String
  kind        FamilyEventKind
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean               @default(false)
  recurrence  FamilyEventRecurrence @default(none)
  note        String?
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  space     Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([spaceId, startsAt])
  @@index([spaceId, recurrence])
}

// ---------------------------------------------------------------------------
// 웹푸시(FCM) 기기 토큰 — 기기(브라우저)마다 하나. 같은 토큰은 마지막으로 등록한 계정에만 붙는다.
// 사용자가 사라지면 함께 지운다(G-06 연쇄). 보관: 오래 갱신되지 않은 토큰은 정리 Cron이 지운다(G-17).
// ---------------------------------------------------------------------------

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt(sort: Desc)])
  @@index([lastSeenAt])
}

// ---------------------------------------------------------------------------
// 레이트 리밋 — DB 고정 창 카운터(S-6: 비용 게이트의 정확한 판정용). 정리 Cron 대상(G-17).
// ---------------------------------------------------------------------------

model RateCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// 미디어 — 업로드는 pending → confirmed. 참조 mutation은 자기 Space의 confirmed 자산만 받는다(G-02).
// 키: pending/{spaceId}/{id} → 확인 후 spaces/{spaceId}/{id} (ARCHITECTURE §5)
// ---------------------------------------------------------------------------

enum MediaKind {
  image
  video
}

enum MediaStatus {
  pending
  confirmed
  deleted
}

model MediaAsset {
  id           String      @id @default(cuid())
  spaceId      String
  uploadedById String
  kind         MediaKind
  contentType  String
  bytes        Int // 선언 크기 = 서명에 들어간 Content-Length(G-01). 상한 200MB < Int 범위
  status       MediaStatus @default(pending)
  createdAt    DateTime    @default(now())
  confirmedAt  DateTime?
  deletedAt    DateTime?

  space       Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  uploadedBy  User             @relation(fields: [uploadedById], references: [id])
  petCover    Pet?             @relation("PetCover")
  momentMedia MomentMedia?     @relation("MomentAsset")
  momentThumb MomentMedia?     @relation("MomentThumbnail")
  storyPhoto  StoryEntry?      @relation("StoryPhoto")
  pregnancy   PregnancyRecord? @relation("PregnancyPhoto")

  @@index([spaceId, status])
  @@index([status, createdAt])
}

// Space별 일 단위 사용량(G-15 가시성). 판정은 MediaAsset 합계·RateCounter로 하고, 이 표는 집계·이상치 감시용.
model UsageCounter {
  spaceId          String
  periodKey        String // YYYY-MM-DD (UTC)
  uploadUrlsIssued Int    @default(0)
  bytesConfirmed   BigInt @default(0)
  bytesDeleted     BigInt @default(0)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, periodKey])
}
