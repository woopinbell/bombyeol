generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// S-1 스파이크 전용 테이블
model SpikePing {
  id        String   @id @default(cuid())
  note      String
  createdAt DateTime @default(now())
}

// S-6 스파이크: 정확한 장기 창(시간·일) 카운터
model RateCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}
