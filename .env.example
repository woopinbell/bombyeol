# 봄별 환경변수 예시. 값은 비워 두고 이름, 형식만 적는다(이름, 발급처는 docs 브랜치 docs/ENV_MANIFEST.md).
# 로컬은 이 파일을 .env로 복사해 채운다. 클라우드 세션은 환경 설정의 환경변수를 쓴다.
# 배포 Worker에는 `wrangler secret put <이름> --env staging|production`으로 별도 등록한다.
# 키 값을 대화, 문서, 커밋에 쓰지 않는다.

# --- 로컬 DB (docker compose) ---------------------------------------------
# scripts/with-local-db.mjs가 마이그레이션, 테스트 때 DATABASE_URL을 이 값으로 덮어쓴다(원격이면 거부).
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bombyeol

# --- 개발용 원격 DB (Supabase, 등급 A) --------------------------------------
# Hyperdrive 생성에만 쓴다. 앱 런타임은 Hyperdrive 바인딩을 쓰고 이 값을 읽지 않는다.
# 형식: postgresql://postgres:<비밀번호>@db.<ref>.supabase.co:5432/postgres (직결, IPv6)
DATABASE_URL=

# --- Cloudflare (범위 제한 API 토큰, 등급 A) --------------------------------
CLOUDFLARE_API_TOKEN=
# 32자 hex
CLOUDFLARE_ACCOUNT_ID=

# --- Auth.js v5 ------------------------------------------------------------
# 32자 이상 랜덤: openssl rand -base64 33 (로컬은 Claude가 .env에 직접 생성)
AUTH_SECRET=
# 카카오 REST API 키 / 카카오 로그인 Client Secret
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# Google OAuth 클라이언트(웹) ID / Secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- R2 미디어 (등급 A, 개발 버킷 한정) -------------------------------------
# 로컬, 테스트는 가짜 저장소를 쓴다. 배포 Worker에는 Secret 유형으로 등록(ENV_MANIFEST Phase 2).
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Firebase 웹푸시 (등급 A, 개발 프로젝트) --------------------------------
# NEXT_PUBLIC_*는 빌드 시점에 클라이언트 번들로 들어간다(배포를 빌드하는 곳에 있어야 한다).
# 프로젝트 설정 > 일반 > 웹 앱 SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 프로젝트 설정 > Cloud Messaging > 웹 구성 > 웹 푸시 인증서(공개 키)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# 서비스 계정 JSON의 project_id, client_email, private_key(큰따옴표, \n 이스케이프 유지).
# 배포 Worker에는 Secret 유형으로 등록. 없으면 발송만 건너뛴다.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- 카카오톡 공유하기 (등급 A, 공개 키) ------------------------------------
# developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키.
# 플랫폼 > Web 사이트 도메인에 배포 주소를 등록해야 동작한다. 비우면 공유 버튼이 기기 공유로 대신한다.
NEXT_PUBLIC_KAKAO_JS_KEY=
