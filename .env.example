# 봄별 환경변수 예시. 값은 비워 두고 이름·형식만 적는다(이름·발급처는 docs 브랜치 docs/ENV_MANIFEST.md).
# 로컬은 이 파일을 .env로 복사해 채운다. 클라우드 세션은 환경 설정의 환경변수를 쓴다.
# 배포 Worker에는 `wrangler secret put <이름> --env staging|production`으로 별도 등록한다.
# 키 값을 대화·문서·커밋에 쓰지 않는다.

# --- 로컬 DB (docker compose) ---------------------------------------------
# scripts/with-local-db.mjs가 마이그레이션·테스트 때 DATABASE_URL을 이 값으로 덮어쓴다(원격이면 거부).
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bombyeol

# --- 개발용 원격 DB (Supabase, 등급 A) --------------------------------------
# Hyperdrive 생성에만 쓴다. 앱 런타임은 Hyperdrive 바인딩을 쓰고 이 값을 읽지 않는다.
# 형식: postgresql://postgres:<비밀번호>@db.<ref>.supabase.co:5432/postgres (직결, IPv6)
DATABASE_URL=

# --- Cloudflare (범위 제한 API 토큰, 등급 A) --------------------------------
CLOUDFLARE_API_TOKEN=
# 32자 hex
CLOUDFLARE_ACCOUNT_ID=

# --- Auth.js v5 ------------------------------------------------------------
# 32자 이상 랜덤: openssl rand -base64 33 (로컬은 Claude가 .env에 직접 생성)
AUTH_SECRET=
# 카카오 REST API 키 / 카카오 로그인 Client Secret
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# Google OAuth 클라이언트(웹) ID / Secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
