{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 최상위 = 로컬 개발(wrangler dev / opennextjs-cloudflare preview).
  // 배포는 반드시 --env staging | production 으로 한다(최상위 이름으로 배포 금지).
  "main": "worker.ts",
  "name": "bombyeol-local",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "bombyeol-local" }],
  "observability": { "enabled": true },
  // 정기 정리(G-05, G-15, G-17): 버려진 업로드, 오래된 카운터. 무료 플랜 Cron 한도 안(계정당 5개)
  "triggers": { "crons": ["17 * * * *"] },
  // 로컬은 localConnectionString(docker-compose Postgres)으로 연결한다. id는 로컬에서 쓰이지 않는 자리표시.
  // staging, production의 Hyperdrive는 리소스 생성 승인 후 각 env 블록에 실제 id로 추가한다.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/bombyeol",
    },
  ],
  "env": {
    // 비프로덕션: 개발 중 배포 스모크, 사용자 기기 확인용(개발용 키, DB만).
    "staging": {
      "name": "bombyeol-staging",
      "workers_dev": true,
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "bombyeol-staging" }],
      // R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY는 Secret으로 등록한다(ENV_MANIFEST Phase 2).
      "vars": {
        "APP_ENV": "staging",
        "R2_BUCKET_NAME": "bombyeol-staging-media",
        // Cron 알림의 링크 주소(요청이 없어 출처를 알 수 없다)
        "APP_ORIGIN": "https://bombyeol-staging.seungwoo7050.workers.dev",
      },
      // Supabase 개발 DB(직결) - 2026-10-01 생성
      // localConnectionString은 배포 명령의 로컬 단계(getPlatformProxy)용이며 배포 Worker에는 쓰이지 않는다.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "610ad8cefd3f49268ca0a581b488d80d",
          "localConnectionString": "postgresql://postgres:postgres@localhost:5432/bombyeol",
        },
      ],
    },
    // 프로덕션: 시크릿은 사용자가 Cloudflare 대시보드/CLI로 직접 등록(등급 B).
    "production": {
      "name": "bombyeol",
      "workers_dev": false,
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "bombyeol" }],
      // APP_ORIGIN은 도메인을 정한 뒤 채운다(출시 마무리 안내서). 비어 있으면 아침 알림을 건너뛴다
      "vars": { "APP_ENV": "production", "APP_ORIGIN": "" },
    },
  },
  "vars": { "APP_ENV": "local", "R2_BUCKET_NAME": "", "APP_ORIGIN": "http://localhost:3000" },
}
