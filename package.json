{
  "name": "bombyeol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "cf:deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "node scripts/with-local-db.mjs prisma migrate dev",
    "db:reset": "node scripts/with-local-db.mjs prisma migrate reset --force",
    "db:studio": "node scripts/with-local-db.mjs prisma studio",
    "test": "node scripts/with-local-db.mjs vitest run",
    "test:watch": "node scripts/with-local-db.mjs vitest",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@trpc/server": "11.19.0",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "12.19.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.8",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "superjson": "2.2.6",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  }
}
